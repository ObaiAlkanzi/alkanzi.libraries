<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Alkanzi.DemoDataImporter</RootNamespace>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuses AppDbContext + the ERP entities so column mapping matches the created tables. -->
    <ProjectReference Include="..\..\src\Alkanzi.DataAccess\Alkanzi.DataAccess.csproj" />
  </ItemGroup>

</Project>
