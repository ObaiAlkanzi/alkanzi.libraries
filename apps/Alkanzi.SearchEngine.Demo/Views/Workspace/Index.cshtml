@{
    Layout = null;
    var apiBaseUrl = (string)ViewBag.ApiBaseUrl;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Procurement Workspace — Alkanzi Search Demo</title>

    @* Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@@400;500;600;700&family=Inter:wght@@400;500;600;700&display=swap" rel="stylesheet">

    @* jQuery must load before DevExtreme *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @* DevExtreme theme *@
    <link href="~/lib/devextreme/css/dx.common.css" rel="stylesheet" />
    <link href="~/lib/devextreme/css/dx.light.css" rel="stylesheet" />

    @* Font Awesome *@
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />

    @* The real Procurement Workspace stylesheets (copied verbatim from the ERP) *@
    <link href="~/css/alkanzi-grid-colors.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/asset-panel.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/listPopup.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pw-supplement.css" rel="stylesheet" asp-append-version="true" />

    @* AngularJS must load BEFORE dx.all.js so DevExtreme registers its 'dx' module *@
    <script src="~/lib/angular/angular.min.js"></script>
    <script src="~/lib/devextreme/js/dx.all.js"></script>

    @* Grid Excel export deps *@
    <script src="~/lib/devextreme/js/jszip.min.js"></script>
    <script src="~/lib/devextreme/js/exceljs.min.js"></script>
    <script src="~/lib/devextreme/js/FileSaver.min.js"></script>

    <style>
        html, body { margin: 0; font-family: 'IBM Plex Sans', system-ui, 'Segoe UI', Roboto, Arial, sans-serif; }
        .ap-erp-toolbar { position: sticky; top: 0; z-index: 40; }
        .ap-main { padding: 18px 22px 40px; }
    </style>
</head>
<body class="dx-viewport">

    <div ng-app="demo" ng-controller="procurementWorkspaceCtrl" ng-init="startup()"
         class="pw-workspace asset-panel">

        <!-- Top bar (dx-toolbar, templates built in the controller) -->
        <div dx-toolbar="mainToolbar" class="ap-erp-toolbar"></div>

        <!-- Global error dialog (site.js is not loaded in this standalone view) -->
        <div id="showAlertPopup" class="form-tab-panel-popup error-popup"></div>

        <main class="ap-main">

            <!-- KPI strip -->
            <section class="ap-kpi-row">
                <div class="ap-kpi-card ap-kpi-card--teal">
                    <div class="ap-kpi-head">
                        <span class="ap-kpi-icon"><i class="fa-solid fa-cart-flatbed"></i></span>
                        <span class="ap-kpi-trend ap-kpi-trend--accent"><i class="fa-solid fa-boxes-stacked"></i> Orders</span>
                    </div>
                    <div class="ap-kpi-value">{{ kpi.purchaseOrders }}</div>
                    <div class="ap-kpi-label">Purchase Orders</div>
                    <div class="ap-kpi-foot">Inventory LPOs on file</div>
                </div>

                <div class="ap-kpi-card ap-kpi-card--amber">
                    <div class="ap-kpi-head">
                        <span class="ap-kpi-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span>
                        <span class="ap-kpi-trend ap-kpi-trend--warn"><i class="fa-solid fa-hourglass-half"></i> Pending</span>
                    </div>
                    <div class="ap-kpi-value">{{ kpi.pending }}</div>
                    <div class="ap-kpi-label">Pending Approval</div>
                    <div class="ap-kpi-meter"><span class="ap-kpi-meter-fill" ng-style="{ width: kpi.pendingPct + '%' }"></span></div>
                    <div class="ap-kpi-foot">{{ kpi.pendingPct }}% awaiting approval</div>
                </div>

                <div class="ap-kpi-card ap-kpi-card--indigo">
                    <div class="ap-kpi-head">
                        <span class="ap-kpi-icon"><i class="fa-solid fa-headset"></i></span>
                        <span class="ap-kpi-trend ap-kpi-trend--accent"><i class="fa-solid fa-phone-volume"></i> Calls</span>
                    </div>
                    <div class="ap-kpi-value">{{ kpi.calls }}</div>
                    <div class="ap-kpi-label">Registered Calls</div>
                    <div class="ap-kpi-foot">Service call registrations</div>
                </div>

                <div class="ap-kpi-card ap-kpi-card--green">
                    <div class="ap-kpi-head">
                        <span class="ap-kpi-icon"><i class="fa-solid fa-truck-field"></i></span>
                        <span class="ap-kpi-trend ap-kpi-trend--accent"><i class="fa-solid fa-handshake"></i> Vendors</span>
                    </div>
                    <div class="ap-kpi-value">{{ kpi.vendors }}</div>
                    <div class="ap-kpi-label">Vendors</div>
                    <div class="ap-kpi-foot">Active suppliers</div>
                </div>
            </section>

            <!-- Top Vendors by Orders — horizontal bar chart -->
            <section class="pw-lpo-rail pw-vendors-panel" style="margin-top:14px;">
                <div class="pw-lpo-rail-head">
                    <i class="fa-solid fa-chart-bar"></i>
                    <span>Top Vendors by Orders</span>
                </div>
                <div dx-chart="topVendors.chart"></div>
            </section>

            <!-- Workspace view switcher + Document Explorer grid -->
            <section style="margin-top:14px;">
                <div class="pw-view-tabs">
                    <button type="button" class="pw-view-tab" ng-repeat="t in workspaceTabs"
                            ng-class="{'is-active': workspaceView === t.key}"
                            ng-click="setWorkspaceView(t.key)">
                        <i class="{{t.icon}}"></i><span>{{t.label}}</span>
                    </button>
                </div>
                <div dx-data-grid="explorerGrid.dataGrid"></div>
            </section>
        </main>

        <!-- Global omni-search results — popover under the toolbar search box -->
        <div dx-popover="globalSearch.popover">
            <div dx-list="globalSearch.list"></div>
        </div>

        <!-- Vendor LPOs listPopup — drill-down from a Top Vendors bar -->
        <div dx-popup="topVendors.vendorLpos.popup">
            <div dx-list="topVendors.vendorLpos.list"></div>
        </div>

        <!-- Document detail (alkanziFormPopup) -->
        <div dx-popup="docForm.popup" class="form-tab-panel-popup">
            <div dx-scroll-view="{width:'100%',height:'100%',showScrollbar:'always'}">
                <div class="col-md-12" style="padding: 8px;">
                    <div dx-form="docForm.form"></div>
                </div>
            </div>
        </div>
    </div>

    <script>window.__API_BASE__ = "@Html.Raw(apiBaseUrl)";</script>
    <script src="~/js/pw-framework.js" asp-append-version="true"></script>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
</body>
</html>
