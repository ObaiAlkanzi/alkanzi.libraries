@{
    Layout = null;
    var apiBaseUrl = (string)ViewBag.ApiBaseUrl;
}
<!DOCTYPE html>
<html lang="en" ng-app="searchApp">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alkanzi Search</title>
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
</head>
<body ng-controller="searchCtrl" ng-cloak>

    <!-- ============ Landing (no search yet) ============ -->
    <div class="s-home" ng-if="!hasSearched">
        <div style="text-align:center">
            <div class="s-wordmark"><span class="b">Alkanzi</span> <span class="n">Search</span></div>
            <div class="s-tagline">Purchase Orders · Calls · Vendors — one box</div>
        </div>
        <div class="s-box">
            <span class="s-ico">🔍</span>
            <input type="text" autofocus placeholder="Search the ERP…"
                   ng-model="term" ng-keydown="$event.keyCode===13 && submit()" />
            <button class="s-clear" ng-if="term.length" ng-click="clear()">✕</button>
        </div>
        <div class="s-home-actions">
            <button class="s-btn primary" ng-click="submit()">Search</button>
            <a class="s-btn" href="/Workspace/Index">Open Workspace</a>
        </div>
    </div>

    <!-- ============ Results ============ -->
    <div ng-if="hasSearched">
        <header class="s-header">
            <a class="s-logo" href="/Workspace/Search"><span class="b">Alkanzi</span> <span class="n">Search</span></a>
            <div class="s-box">
                <span class="s-ico">🔍</span>
                <input type="text" placeholder="Search the ERP…"
                       ng-model="term" ng-keydown="$event.keyCode===13 && submit()" />
                <button class="s-clear" ng-if="term.length" ng-click="clear()">✕</button>
            </div>
            <a class="s-back" href="/Workspace/Index">← Workspace</a>
        </header>

        <div class="s-body">
            <!-- type filters -->
            <div class="s-tabs">
                <button class="s-tab" ng-repeat="t in tabs"
                        ng-class="{ active: activeType === t.key }"
                        ng-click="setType(t.key)">{{ t.label }}</button>
            </div>

            <div class="s-stats" ng-if="!loading && results.length">
                {{ rangeLabel() }} &nbsp;·&nbsp; {{ elapsed }} seconds
            </div>

            <div class="s-loading" ng-if="loading">Searching…</div>

            <!-- results -->
            <div ng-if="!loading">
                <div class="s-result" ng-repeat="r in results">
                    <div class="s-crumb">
                        <span class="s-badge" style="background: {{ typeMeta(r.entityType).color }}">{{ typeMeta(r.entityType).icon }}</span>
                        {{ typeMeta(r.entityType).label }} · #{{ r.id }}
                    </div>
                    <div class="s-title">{{ r.title }}</div>
                    <div class="s-snippet"><b>{{ r.subtitle }}</b><span ng-if="r.branchId"> — Branch {{ r.branchId }}</span></div>
                </div>

                <!-- empty -->
                <div class="s-empty" ng-if="!results.length">
                    <div class="big">No results found for <b>{{ term }}</b>.</div>
                    <div>Try a different term, or remove the type filter.</div>
                </div>

                <!-- pager -->
                <div class="s-pager" ng-if="results.length">
                    <button class="pg nav" ng-click="prev()" ng-disabled="page === 1">‹ Prev</button>
                    <button class="pg" ng-repeat="p in pageNumbers()"
                            ng-class="{ current: p === page }" ng-click="goto(p)">{{ p }}</button>
                    <button class="pg nav" ng-click="next()" ng-disabled="!hasNext">Next ›</button>
                </div>
            </div>
        </div>
    </div>

    <script>window.__API_BASE__ = "@Html.Raw(apiBaseUrl)";</script>
    <script src="~/lib/angular/angular.min.js"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
</body>
</html>
