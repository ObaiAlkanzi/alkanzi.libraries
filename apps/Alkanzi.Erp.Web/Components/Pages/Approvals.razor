@page "/approvals"
@using Alkanzi.ErpServices
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Approvals</PageTitle>

<h1>Approval workbench</h1>
<p class="text-secondary">
    Drive the ERP approval engine against live rows. Each action runs in its own
    scope; with <strong>Dry run</strong> on, the work is rolled back so nothing
    persists to the ERP.
</p>

<div class="row g-3 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">Document type</label>
        <input class="form-control" @bind="docType" placeholder="e.g. callRegistration" />
    </div>
    <div class="col-auto">
        <label class="form-label">Transaction id</label>
        <input type="number" class="form-control" style="width: 8rem" @bind="transId" />
    </div>
    <div class="col-auto">
        <label class="form-label">Rework → level</label>
        <input type="number" class="form-control" style="width: 8rem" @bind="targetLevel" />
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="dry" @bind="dryRun" />
            <label class="form-check-label" for="dry">Dry run (roll back)</label>
        </div>
    </div>
</div>

<div class="btn-group mb-3" role="group">
    <button class="btn btn-outline-secondary" disabled="@busy" @onclick="Load">Load</button>
    <button class="btn btn-primary" disabled="@busy" @onclick="() => Run(ApprovalAction.Submit)">Submit</button>
    <button class="btn btn-success" disabled="@busy" @onclick="() => Run(ApprovalAction.Approve)">Approve</button>
    <button class="btn btn-danger" disabled="@busy" @onclick="() => Run(ApprovalAction.Reject)">Reject</button>
    <button class="btn btn-warning" disabled="@busy" @onclick="() => Run(ApprovalAction.Rework)">Rework</button>
</div>

@if (busy)
{
    <p><em>Working…</em></p>
}

@if (error is not null)
{
    <div class="alert alert-danger"><strong>Error:</strong> @error</div>
}

@if (result is not null)
{
    <div class="alert @(result.Status ? "alert-success" : "alert-info")">
        <div><strong>Outcome:</strong> @result.Outcome (@dryRunNote)</div>
        <div><strong>Message:</strong> @result.Message</div>
        @if (result.Row is not null)
        {
            <div>@Describe(result.Row)</div>
        }
    </div>
}
else if (loaded is not null)
{
    <div class="alert alert-secondary">
        <strong>Loaded:</strong> @Describe(loaded)
    </div>
}
else if (loadMissed)
{
    <div class="alert alert-warning">No row for <code>@docType</code> / <code>@transId</code> (missing or soft-deleted).</div>
}

@code {
    private string docType = "callRegistration";
    private int transId = 1;
    private int targetLevel = 1;
    private bool dryRun = true;

    private bool busy;
    private string? error;
    private ApprovalResult? result;
    private IErpApprovable? loaded;
    private bool loadMissed;
    private string dryRunNote = "";

    private Task Load() => WithEngine(async engine =>
    {
        result = null;
        loaded = await engine.GetAsync(docType, transId);
        loadMissed = loaded is null;
    });

    private Task Run(ApprovalAction action) => WithEngine(async engine =>
    {
        loaded = null;
        loadMissed = false;
        dryRunNote = dryRun ? "rolled back" : "committed";

        result = action == ApprovalAction.Rework
            ? await engine.ReworkAsync(docType, transId, targetLevel)
            : await engine.ApplyApprovalAsync(docType, transId, action);
    });

    // A fresh scope (and therefore a fresh ErpDbContext) per action keeps Blazor
    // Server's long-lived circuit from sharing one context across operations.
    private async Task WithEngine(Func<IErpApprovalEngine, Task> body)
    {
        busy = true;
        error = null;

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<ErpDbContext>();
            var engine = scope.ServiceProvider.GetRequiredService<IErpApprovalEngine>();

            await using var tx = dryRun ? await db.Database.BeginTransactionAsync() : null;

            await body(engine);

            if (tx is not null)
            {
                await tx.RollbackAsync();
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string Describe(IErpApprovable row)
        => $"status {row.APPROVE_STATUS} ({(ApprovalAction)row.APPROVE_STATUS}), level {row.APPROVE_LEVEL}";
}
