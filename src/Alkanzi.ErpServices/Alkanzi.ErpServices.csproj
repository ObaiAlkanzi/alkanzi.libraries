<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target net8.0;net10.0, net8 first: net8 is the framework the widest
         range of tooling loads without a preview/newer install, so listing it
         first makes it the target the IDE analyses by default. The app and the
         net10 test project still get net10. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Alkanzi.ErpServices</PackageId>
    <Version>4.0.7</Version>
    <Authors>Obai Alkanzi</Authors>
    <Description>ERP-specific approval and workflow engine for the Fakhruddin ERP on Oracle: dispatches document types to their transaction tables, moves approval state (submit / approve / reject / rework), resolves workflows, runs each level's UPDATE_SENTENCE, and writes the approval log — plus an Oracle stored-procedure / function service over the same connection.</Description>
    <PackageTags>erp;approval;workflow;oracle;efcore;entityframeworkcore;dotnet;softdelete;audit</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ObaiAlkanzi/alkanzi.libraries</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ObaiAlkanzi/alkanzi.libraries</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The mapping DTOs (entities, audit/tenant columns) are intentionally
         undocumented; ship XML docs for the rich API surface without CS1591
         noise for every column. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- EF Core + the Oracle provider, pinned per framework. The Oracle ADO.NET
       types the procedure wrappers use (OracleCommand, OracleDbType,
       OracleRefCursor, OracleDecimal) exist in both provider majors, so the code
       compiles unchanged against each. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[8.0.11,9.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[8.0.11,9.0.0)" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.60" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[10.0.0,11.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.0,11.0.0)" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26200" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Modules\Leasing\" />
    <Folder Include="Modules\Legal\" />
    <Folder Include="Modules\Finance\" />
    <Folder Include="Modules\Inventory\" />
    <Folder Include="Modules\CRM\" />
    <Folder Include="Modules\HRMS\" />
    <Folder Include="Modules\Security\Entities\" />
  </ItemGroup>

</Project>
